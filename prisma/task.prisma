enum Status {
    PENDING
    IN_PROGRESS
    DONE
}

model Task {
    id          String    @id @default(uuid())
    title       String
    description String
    status      Status    @default(PENDING)
    startDate   DateTime
    endDate     DateTime
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt

    members      Member[] 
}
